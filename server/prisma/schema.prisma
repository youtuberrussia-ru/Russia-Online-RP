generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AdminRole {
  GA
  ZGA
  SENIOR_ADMIN
  ADMIN
  SENIOR_MODERATOR
  MODERATOR
  JUNIOR_MODERATOR
}

enum OrgCode {
  MVD
  FSB
  ARMY
  EMERCOM
  HEALTH
  PROSECUTOR
  GOVERNMENT
  TRAFFIC_POLICE
  MEDIA
  FSIN
  CENTRAL_BANK
}

enum BanStatus {
  ACTIVE
  REVOKED
}

model User {
  id            String            @id @default(cuid())
  email         String            @unique
  passwordHash  String
  emailVerified Boolean           @default(false)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  profile       PlayerProfile?
  wallet        Wallet?
  bankAccount   BankAccount?
  adminStaff    AdminStaff?
  auditActor    AdminAuditLog[]   @relation("AuditActor")
  bans          AccountBan[]
  reports       PlayerReport[]
  dailyClaims   DailyRewardClaim[]
  banAppeals    BanAppeal[]
}

model PlayerProfile {
  id          String          @id @default(cuid())
  userId      String          @unique
  nickname    String          @unique
  level       Int             @default(1)
  experience  Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  memberships OrgMembership[]
  applications OrganizationApplication[]
  vehicles     PlayerVehicle[]
  properties   PlayerProperty[]
  propertyAccess PropertyAccess[]
  ownedBusinesses Business[] @relation("BusinessOwner")
  businessEmployment BusinessEmployee[]
  jobShifts    JobShift[]
}

model Wallet {
  id        String                @id @default(cuid())
  userId    String                @unique
  balance   BigInt                @default(0)
  updatedAt DateTime              @updatedAt
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  ledger    EconomyTransaction[]
}

model EconomyTransaction {
  id             String   @id @default(cuid())
  walletId       String
  amount         BigInt
  balanceAfter   BigInt
  reason         String
  idempotencyKey String   @unique
  createdAt      DateTime @default(now())
  wallet         Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt])
}

model AdminStaff {
  id          String    @id @default(cuid())
  userId      String    @unique
  role        AdminRole
  active      Boolean   @default(true)
  appointedBy String
  appointedAt DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  targetType String
  targetId   String
  reason     String
  metadata   Json?
  createdAt  DateTime @default(now())
  actor      User     @relation("AuditActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([actorId, createdAt])
  @@index([targetType, targetId, createdAt])
}

model Organization {
  id          String             @id @default(cuid())
  code        OrgCode            @unique
  name        String
  description String
  createdAt   DateTime           @default(now())
  ranks       OrganizationRank[]
  members     OrgMembership[]
  applications OrganizationApplication[]
}

model OrganizationRank {
  id             String           @id @default(cuid())
  organizationId String
  rank           Int
  title          String
  salary         BigInt           @default(0)
  permissions    String[]
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships    OrgMembership[]

  @@unique([organizationId, rank])
}

model OrgMembership {
  id             String           @id @default(cuid())
  profileId      String
  organizationId String
  rankId         String
  joinedAt       DateTime         @default(now())
  active         Boolean          @default(true)
  profile        PlayerProfile    @relation(fields: [profileId], references: [id], onDelete: Cascade)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rank           OrganizationRank @relation(fields: [rankId], references: [id], onDelete: Restrict)

  @@index([organizationId, active])
  @@unique([profileId, organizationId])
}

model AccountBan {
  id        String    @id @default(cuid())
  userId    String
  status    BanStatus @default(ACTIVE)
  reason    String
  evidence  Json
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  revokedBy String?
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  appeals   BanAppeal[]

  @@index([userId, status])
}

enum ReportStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  REJECTED
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model PlayerReport {
  id          String       @id @default(cuid())
  authorId    String
  targetId    String?
  category    String
  description String
  status      ReportStatus @default(OPEN)
  assignedTo  String?
  resolution  String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  author      User         @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([targetId, createdAt])
}

model OrganizationApplication {
  id             String            @id @default(cuid())
  profileId      String
  organizationId String
  answers        Json
  status         ApplicationStatus @default(PENDING)
  reviewedBy     String?
  reviewNote     String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  profile        PlayerProfile     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status, createdAt])
  @@index([profileId, createdAt])
}

model DailyRewardClaim {
  id        String   @id @default(cuid())
  userId    String
  dayKey    String
  amount    BigInt
  streak    Int      @default(1)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dayKey])
}

enum BanAppealStatus {
  PENDING
  APPROVED
  DENIED
}

model BanAppeal {
  id         String           @id @default(cuid())
  userId     String
  banId      String
  message    String
  status     BanAppealStatus  @default(PENDING)
  reviewedBy String?
  decision   String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  ban        AccountBan       @relation(fields: [banId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([userId, createdAt])
}


enum VehicleStatus {
  STORED
  ACTIVE
  IMPOUNDED
}

model PlayerVehicle {
  id             String        @id @default(cuid())
  profileId      String
  modelCode      String
  displayName    String
  plate          String        @unique
  purchaseKey    String        @unique
  purchasedPrice BigInt
  status         VehicleStatus @default(STORED)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  profile        PlayerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, status])
  @@index([modelCode])
}


enum JobShiftStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

model JobShift {
  id             String          @id @default(cuid())
  profileId      String
  jobCode        String
  status         JobShiftStatus  @default(ACTIVE)
  startedAt      DateTime        @default(now())
  endedAt        DateTime?
  payout         BigInt          @default(0)
  finishKey      String?         @unique
  profile        PlayerProfile   @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, status, startedAt])
  @@index([profileId, endedAt])
}


model BankAccount {
  id           String            @id @default(cuid())
  userId       String            @unique
  balance      BigInt            @default(0)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions BankTransaction[]
  outgoing     BankTransfer[]    @relation("BankTransferFrom")
  incoming     BankTransfer[]    @relation("BankTransferTo")
}

model BankTransaction {
  id             String      @id @default(cuid())
  accountId      String
  amount         BigInt
  balanceAfter   BigInt
  reason         String
  idempotencyKey String      @unique
  createdAt      DateTime    @default(now())
  account        BankAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, createdAt])
}

model BankTransfer {
  id            String      @id @default(cuid())
  requestKey    String      @unique
  fromAccountId String
  toAccountId   String
  amount        BigInt
  createdAt     DateTime    @default(now())
  fromAccount   BankAccount @relation("BankTransferFrom", fields: [fromAccountId], references: [id], onDelete: Cascade)
  toAccount     BankAccount @relation("BankTransferTo", fields: [toAccountId], references: [id], onDelete: Cascade)

  @@index([fromAccountId, createdAt])
  @@index([toAccountId, createdAt])
}


enum PropertyStatus {
  OWNED
  FORECLOSED
}

model PlayerProperty {
  id             String         @id @default(cuid())
  profileId      String
  propertyCode   String
  displayName    String
  propertyType   String
  district       String
  interiorCode   String
  storageSlots   Int            @default(0)
  parkingSlots   Int            @default(0)
  purchaseKey    String         @unique
  purchasedPrice BigInt
  status         PropertyStatus @default(OWNED)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  profile        PlayerProfile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  accessGrants   PropertyAccess[]

  @@unique([profileId, propertyCode])
  @@index([profileId, status])
  @@index([propertyCode])
}


model PropertyAccess {
  id              String         @id @default(cuid())
  propertyId      String
  granteeProfileId String
  canEnter        Boolean        @default(true)
  canUseStorage   Boolean        @default(false)
  canPark         Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  property        PlayerProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  grantee         PlayerProfile  @relation(fields: [granteeProfileId], references: [id], onDelete: Cascade)

  @@unique([propertyId, granteeProfileId])
  @@index([granteeProfileId, updatedAt])
}


enum BusinessStatus {
  ACTIVE
  SUSPENDED
}

model Business {
  id              String         @id @default(cuid())
  businessCode    String         @unique
  displayName     String
  businessType    String
  district        String
  ownerProfileId  String
  purchaseKey     String         @unique
  purchasedPrice  BigInt
  cashBalance     BigInt         @default(0)
  status          BusinessStatus @default(ACTIVE)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  owner           PlayerProfile  @relation("BusinessOwner", fields: [ownerProfileId], references: [id], onDelete: Restrict)
  employees       BusinessEmployee[]
  ledger          BusinessLedger[]
  stockItems      BusinessStockItem[]
  sales           BusinessSale[]
  settlements     BusinessSettlement[]
  monthlyRent     BigInt         @default(0)
  taxRateBps      Int            @default(500)
  lastSettlementAt DateTime      @default(now())

  @@index([ownerProfileId, status])
  @@index([businessType, district])
}

model BusinessEmployee {
  id              String        @id @default(cuid())
  businessId      String
  profileId       String
  jobTitle        String        @default("Сотрудник")
  canManageStaff  Boolean       @default(false)
  canManageStock  Boolean       @default(false)
  canManageCash   Boolean       @default(false)
  monthlySalary   BigInt        @default(0)
  hiredAt         DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  business        Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  profile         PlayerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([businessId, profileId])
  @@index([profileId, hiredAt])
}

model BusinessLedger {
  id             String   @id @default(cuid())
  businessId     String
  kind           String
  amount         BigInt
  balanceAfter   BigInt
  reason         String
  idempotencyKey String   @unique
  createdAt      DateTime @default(now())
  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
}


model BusinessStockItem {
  id          String   @id @default(cuid())
  businessId  String
  productCode String
  quantity    Int      @default(0)
  updatedAt   DateTime @updatedAt
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  @@unique([businessId, productCode])
  @@index([businessId, updatedAt])
}

model BusinessSale {
  id             String   @id @default(cuid())
  businessId     String
  buyerProfileId String
  productCode    String
  quantity       Int
  totalAmount    BigInt
  idempotencyKey String   @unique
  createdAt      DateTime @default(now())
  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  @@index([businessId, createdAt])
  @@index([buyerProfileId, createdAt])
}

model BusinessSettlement {
  id             String   @id @default(cuid())
  businessId     String
  periodStart    DateTime
  periodEnd      DateTime
  grossRevenue   BigInt
  payroll        BigInt
  rent           BigInt
  tax            BigInt
  totalPaid      BigInt
  idempotencyKey String   @unique
  createdAt      DateTime @default(now())
  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  @@index([businessId, periodEnd])
}
